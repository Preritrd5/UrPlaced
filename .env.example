# ==============================================================================
# UrPlaced: Multi-College Placement Preparation & Management SaaS
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control or expose service-role credentials to clients.

# --- Application Canonical Base URL ---
# Used for generating recipient-accessible invitation links and auth redirects
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Configuration (Client / Public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Configuration (Server / Service Role - Server Only) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- Transactional Email (Resend) ---
# Secret Resend API key (starts with re_...)
RESEND_API_KEY=your-resend-api-key
# Verified sender email in your Resend account (default testing sender: onboarding@resend.dev)
RESEND_FROM_EMAIL=UrPlaced <onboarding@resend.dev>

# --- Code Execution Runner (Isolated Assessment Sandbox - Optional) ---
CODE_RUNNER_ENDPOINT=https://runner.your-domain.internal/execute
CODE_RUNNER_TOKEN=your-runner-auth-token

# --- AI & Extraction Services (Optional) ---
GEMINI_API_KEY=your-gemini-api-key

NEXT_PUBLIC_SUPPORT_EMAIL="your-email-id"

# --- Razorpay Payment Gateway (Test Mode) ---
# Server-side API credentials (keep private, do not prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Client-side public key for Razorpay Standard Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# --- Billing Background Jobs & Automation (Vercel Cron) ---
CRON_SECRET=your_vercel_cron_secret_token
BILLING_PRE_COLLECTION_NOTICE_DAYS=2


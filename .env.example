# ==============================================================================
# UrPlaced: Multi-College Placement Preparation & Management SaaS
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control or expose service-role credentials to clients.

# --- Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Configuration (Client / Public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Configuration (Server / Service Role - Server Only) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- Code Execution Runner (Isolated Assessment Sandbox - Optional) ---
CODE_RUNNER_ENDPOINT=https://runner.your-domain.internal/execute
CODE_RUNNER_TOKEN=your-runner-auth-token

# --- Email & Notifications (Optional) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_API_KEY=your-email-api-key

# --- AI & Extraction Services (Optional) ---
GEMINI_API_KEY=your-gemini-api-key
